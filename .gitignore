# Built server binary. Anchored with a leading slash: a bare `archivist`
# pattern also matches the DIRECTORY cmd/archivist, which silently kept the
# server's entrypoint out of the repository until a CI cross-compile failed
# with "cmd/archivist: directory not found".
/archivist-server
/archivist-relay
/archivist-client
/dist/
*.test

# Plugin build output
node_modules/
/main.js
dist-test/
*.js.map
data.json

# Worktrees for isolated implementation branches.
.worktrees/

# Local agent planning artifacts. Product documentation belongs in docs/, but
# execution plans and session specs do not belong in the public repository.
/docs/superpowers/
/docs/plans/
/docs/**/*-plan.md

# Credentials, none of which have ever been committed. Listed so that stays
# true once other people start sending pull requests.
.env
.env.*
tokens.json
*.pem
*.key
gitleaks-report.json
