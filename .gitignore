# Built server binary. Anchored with a leading slash: a bare `archivist`
# pattern also matches the DIRECTORY cmd/archivist, which silently kept the
# server's entrypoint out of the repository until a CI cross-compile failed
# with "cmd/archivist: directory not found".
/archivist-server
/archivist-relay
/archivist-client
/dist/
*.test

# Plugin build output
node_modules/
/main.js
dist-test/
*.js.map
data.json

# Worktrees for isolated implementation branches.
.worktrees/
