  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pkronstrom/obsidian-archivist/issues"
  },
  "homepage": "https://github.com/pkronstrom/obsidian-archivist#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
